# Copy this file to .env and adjust the values for your deployment.
ATLANTEAN_PORT=8080
ATLANTEAN_API_KEYS=prod-client-key-1,prod-client-key-2
ATLANTEAN_ADMIN_KEYS=prod-admin-key
ATLANTEAN_REQUIRE_AUTH=yes
# Optional: override the database location inside the container.
# ATLANTEAN_DB=/data/atlantean_prod.sqlite
# Provide explicit key file paths if you mount different secrets locations.
# ATLANTEAN_API_KEY_FILE=/secrets/api_keys.txt
# ATLANTEAN_ADMIN_KEY_FILE=/secrets/admin_keys.txt
